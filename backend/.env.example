# LLM reasoning backend (OpenAI-compatible API)
# Point this at LM Studio, Ollama (/v1), vLLM, or any OpenAI-compatible server.

# LM Studio (default):
LLM_BASE_URL=http://localhost:1234/v1
# Agentic layer uses gpt-oss-20b (native tool-calling).
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=lm-studio
# Local embeddings for pgvector RAG (keep EMBED_DIM in sync with the model).
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
EMBED_DIM=768
# Max agent loop turns (LLM <-> tools) before forcing a final answer.
AGENT_MAX_STEPS=6

# Ollama alternative:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma3:4b
# LLM_API_KEY=ollama

# ─────────────────────────────────────────────
# Database (PostgreSQL) — consultation/report history
# ─────────────────────────────────────────────
# Async SQLAlchemy URL. Local Homebrew Postgres uses trust auth (no password).
DATABASE_URL=postgresql+asyncpg://pravin@localhost:5432/cds_engine
# Set to false to run fully stateless (no history persisted).
DB_ENABLED=true

# ─────────────────────────────────────────────
# Server / deployment
# ─────────────────────────────────────────────
# Backend bind address and port (API-only service).
HOST=0.0.0.0
PORT=8000
# Set true to ALSO serve the built frontend from this backend (single-port).
# Leave false to run frontend + backend as two separate services.
SERVE_FRONTEND=false
# CORS: comma-separated origins, or * for any (default). When the frontend runs
# on its own port, list its origin here. Credentials are only enabled when
# explicit origins are set.
# CORS_ORIGINS=http://localhost:5173

# Classifier confidence (%) below which an image finding is flagged uncertain.
# CONFIDENCE_UNCERTAIN_THRESHOLD=55

# ─────────────────────────────────────────────
# Infrastructure services (see infra/docker-compose.yml)
# ─────────────────────────────────────────────
# Used from Phase 1 onward (cache, rate limiting, object storage, chat logs).
# When running against the Docker stack from the HOST, note Postgres is on 5433.
# DATABASE_URL=postgresql+asyncpg://cds:cds@localhost:5433/cds_engine

# Redis — cache, rate limiting, and (later) Celery broker.
REDIS_URL=redis://localhost:6379/0
# Set false to run without Redis (cache off, rate limiting falls back to
# per-process token buckets). The app still boots if Redis is simply unreachable.
REDIS_ENABLED=true
# Cache-aside defaults.
CACHE_DEFAULT_TTL=30
CACHE_VERSION=v1

# MinIO — S3-compatible object storage for images/PDFs.
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=minio12345
# MINIO_SECURE=false

# MongoDB — scoped to chat logs / AI traces only.
# MONGO_URL=mongodb://cds:cds@localhost:27017

# Auth — set a strong secret in production: `openssl rand -hex 32`
# JWT_SECRET=dev-insecure-change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
